# anthropic | anthropic_vertex | gemini_vertex
LLM_PROVIDER=anthropic

# Direct Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# GCP / Vertex (uses Application Default Credentials, no key here)
GCP_PROJECT=
GCP_REGION=us-east5
VERTEX_CLAUDE_MODEL=claude-sonnet-4-5@20250929   # check Model Garden for the ID available to you
VERTEX_GEMINI_MODEL=gemini-2.5-pro

DATA_DIR=./data
AGENT_MAX_STEPS=8